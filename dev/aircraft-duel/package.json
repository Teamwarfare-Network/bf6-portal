{
  "name": "twl-aircraft-duel",
  "version": "0.739.0",
  "private": true,
  "description": "Modular build for TWL Aircraft-Duel BF6 Portal experience (forked from helis-only v0.737)",
  "scripts": {
    "build": "bf6-portal-bundler --entrypoint ./src/index.ts --outDir ./dist && node scripts/postbuild.js && node scripts/verify.js",
